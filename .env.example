# App
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_MODE=local
DEFAULT_WORKSPACE_SLUG=default
DEFAULT_COUNTRY=TR
DEFAULT_LOCALE=tr-TR
DEFAULT_CURRENCY=TRY

# PostgreSQL (docker-compose local default)
DATABASE_URL=postgresql://productintel:productintel_local_password@localhost:5432/product_intelligence

# Provider selection
PROVIDER_MODE=demo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_API_KEY=
KEEPA_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional AI helper (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=

# Scheduled jobs
CRON_SECRET=change-this-to-a-long-random-secret

# Optional object storage (not required for MVP)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
